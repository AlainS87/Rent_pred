{
  "architecture": {
    "batch_size": 1024,
    "dropout": 0.1,
    "epochs": 20,
    "hidden_sizes": [
      128,
      64
    ],
    "learning_rate": 0.001
  },
  "features": [
    "RENT_APPROVAL_DATE",
    "TOWN",
    "BLOCK",
    "STREET",
    "FLAT_TYPE",
    "FLAT_MODEL",
    "FLOOR_AREA_SQM",
    "FURNISHED",
    "LEASE_COMMENCE_DATE",
    "FEE",
    "bank_basket_return_lag1"
  ],
  "preprocess": {
    "categorical": "onehot",
    "numeric_impute": "median",
    "rare_min_count": 30,
    "scale": "standard"
  }
}
